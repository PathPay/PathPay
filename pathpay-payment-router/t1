<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PathPay Payment Router</title>
    <link rel="stylesheet" href="./styles.css" />
  </head>
  <body>
    <main class="shell">
      <section class="workspace">
        <aside class="panel control-panel">
          <div class="brand-row">
            <div class="mark">P</div>
            <div>
              <h1>PathPay</h1>
              <p>Payment compatibility graph</p>
            </div>
          </div>

          <form id="routeForm" class="form">
            <label for="productUrl">Product or checkout link</label>
            <input
              id="productUrl"
              name="productUrl"
              type="url"
              placeholder="https://www.namecheap.com/domains"
              autocomplete="off"
              required
            />

            <label for="country">User country</label>
            <select id="country" name="country">
              <option value="Nigeria">Nigeria</option>
              <option value="Gabon">Gabon</option>
              <option value="Ghana">Ghana</option>
              <option value="Kenya">Kenya</option>
              <option value="South Africa">South Africa</option>
              <option value="unknown">Unknown</option>
            </select>

            <label>Available payment methods</label>
            <div class="method-grid" id="methodGrid"></div>

            <button class="primary-action" type="submit">Find payment route</button>
          </form>

          <div class="memory-card">
            <span class="eyebrow">Memory loaded</span>
            <strong id="memoryCount">0 reports</strong>
            <p>From Reddit, Nairaland, and forum extraction rows.</p>
          </div>
        </aside>

        <section class="results">
          <div class="summary-band">
            <div>
              <span class="eyebrow">Detected merchant</span>
              <h2 id="merchantName">Namecheap</h2>
            </div>
            <div class="score-box">
              <span>Confidence</span>
              <strong id="routeScore">Medium</strong>
            </div>
          </div>

          <div class="grid-two">
            <section class="panel">
              <div class="section-title">
                <h3>Recommended Routes</h3>
                <span id="recommendationCount">0</span>
              </div>
              <div id="recommendations" class="stack"></div>
            </section>

            <section class="panel">
              <div class="section-title">
                <h3>Avoid Or Retry Carefully</h3>
                <span id="avoidCount">0</span>
              </div>
              <div id="avoidList" class="stack"></div>
            </section>
          </div>

          <section class="panel graph-panel">
            <div class="section-title">
              <h3>Memory Graph</h3>
              <span id="edgeCount">0 edges</span>
            </div>
            <div id="graphEdges" class="edges"></div>
          </section>

          <section class="panel evidence-panel">
            <div class="section-title">
              <h3>Evidence</h3>
              <span id="evidenceCount">0 sources</span>
            </div>
            <div id="evidenceList" class="evidence-list"></div>
          </section>
        </section>
      </section>
    </main>

    <script src="./app.js"></script>
  </body>
</html>
